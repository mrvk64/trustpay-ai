# PayPal Sandbox only. Copy this file to .env.local and replace the placeholders.
# The client ID is public by design; the secret must remain server-only.
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_secret_here

# Claude API credentials: server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# Optional caps on Claude reviews (defaults shown). The daily cap bounds API spend
# when the app is public; it resets at midnight UTC.
# REVIEW_LIMIT_PER_SESSION_HOUR=20
# REVIEW_LIMIT_PER_IP_HOUR=40
# REVIEW_LIMIT_PER_DAY=100
